{
  "permissions": {
    "deny": [
      "Edit(./Docs/SHARED/**)",
      "Write(./Docs/SHARED/**)",
      "NotebookEdit(./Docs/SHARED/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-release-branch.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
